# Fictional seed data mirroring the shape of ldap.openmrs.org. The __*_PASSWORD__ placeholders are
# replaced with password hashes by entrypoint.sh. erin is in none of the Atlassian groups and frank is only
# in confluence-users. grace has a legacy email-address uid, so she is skipped by the SCIM sync. Groups
# carry an empty member value, as production does, because groupOfNames requires at least one member.

dn: dc=openmrs,dc=org
objectClass: dcObject
objectClass: organization
dc: openmrs
o: OpenMRS

dn: ou=users,dc=openmrs,dc=org
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=openmrs,dc=org
objectClass: organizationalUnit
ou: groups

dn: ou=system,dc=openmrs,dc=org
objectClass: organizationalUnit
ou: system

dn: uid=omrsid,ou=system,dc=openmrs,dc=org
objectClass: account
objectClass: simpleSecurityObject
uid: omrsid
userPassword: __BIND_PASSWORD__

dn: uid=alice,ou=users,dc=openmrs,dc=org
objectClass: inetOrgPerson
objectClass: extensibleObject
uid: alice
cn: Alice
sn: Adeyemi
displayName: Alice Adeyemi
mail: alice@example.com
userPassword: __USER_PASSWORD__

